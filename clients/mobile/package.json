{
  "name": "@art-pollinator/mobile",
  "version": "0.0.0",
  "description": "React Native (Expo) client — iOS, Android, and web from one codebase. Composition root for the mobile/web targets (issue #29). Depends on core, never depended on by it.",
  "license": "MIT",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.native.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@art-pollinator/core": "*",
    "expo": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2"
  }
}
